//fonction parcours de la page 10 mais pas utile à la recherche de chemin
void push(t_stack *s, t_vertex v) {
	t_node *n = malloc(sizeof(*n));
	n->val = v;
	n->p_next = *s;
	*s = n;
}

t_bool Recherche_recur_f(const t_graph *g, t_vertex x, t_vertex y, t_bool *marking, t_stack *stack)
{

if (x==y) {
	push(stack, x);
	return 1;
}
else{
if (marking[x]==0) {
    marking[x] = 1;
    
    for (t_node *p = successeurs(g, x);p != NULL; p = p->p_next {
    	t_vertex w = p-> val;
    	if (Recherche_recur_f(g, w, y, marking, stack)) {
    	    push(stack, x);
    	    return 1;  	  
}
}
return 0;
}

t_bool Recherche_recur(const t_graph *g, t_vertex x, t_vertex y, t_stack *stack)
{
int n = taille_graphe(g);
t_bool *marking = malloc(n * sizeof(*marking));
for (int i=0;i<n;i++)
	marking[i] = 0;
*stack = NULL;
t_bool found = Recherche_recur_f(g, x, y, marking, stack);

free(marking);
return found;

}

