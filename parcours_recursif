#include <stdio.h>
#include <stdlib.h>
#include <assert.h>

typedef int t_bool;
typedef int t_vertex;

// création de la pile pour le chemin

typedef struct node {
    t_vertex val;
    struct node *next;
} t_node;

typedef t_node* t_stack;

static void push(t_stack *s, t_vertex v) {
    t_node *n = (t_node*)malloc(sizeof(*n));
    assert(n != NULL);
    n->val = v;
    n->next = *s;
    *s = n;
}

static t_bool stack_empty(const t_stack *s) {
    return (*s == NULL);
}

static t_vertex pop(t_stack *s) {
    assert(s != NULL && *s != NULL);
    t_node *n = *s;
    t_vertex v = n->val;
    *s = n->next;
    free(n);
    return v;
}

static void stack_free(t_stack *s) {
    while (!stack_empty(s)) (void)pop(s);
}

// Création du graphe sous forme matricielle

typedef struct {
    int size;
    unsigned char **adj; /* adj[x][y] = 1 si arc x->y */
} t_graph;

static t_graph* graph_create(int n) {
    assert(n > 0);
    t_graph *g = (t_graph*)malloc(sizeof(*g));
    assert(g != NULL);

    g->size = n;
    g->adj = (unsigned char**)malloc(n * sizeof(*g->adj));
    assert(g->adj != NULL);

    for (int i = 0; i < n; i++) {
        g->adj[i] = (unsigned char*)calloc(n, sizeof(*g->adj[i]));
        assert(g->adj[i] != NULL);
    }
    return g;
}

static void graph_free(t_graph *g) {
    if (!g) return;
    for (int i = 0; i < g->size; i++) free(g->adj[i]);
    free(g->adj);
    free(g);
}

static int taille_graphe(const t_graph *g) {
    return g->size;
}

static void graph_add_edge(t_graph *g, t_vertex x, t_vertex y) {
    assert(g != NULL);
    assert(0 <= x && x < g->size);
    assert(0 <= y && y < g->size);
    g->adj[x][y] = 1;
}

//Recherche récursive 

static t_bool Recherche_recur_f(const t_graph *g,
                               t_vertex x, t_vertex y,
                               t_bool *marking,
                               t_stack *path)
{
    if (x == y) {
        push(path, x);
        return 1;
    }

    if (marking[x]) return 0;
    marking[x] = 1;

    // Parcours des successeurs via la ligne x de la matrice 

    for (t_vertex w = 0; w < g->size; w++) {
        if (g->adj[x][w]) {
            if (Recherche_recur_f(g, w, y, marking, path)) {
                push(path, x);
                return 1;
            }
        }
    }
    return 0;
}

t_bool Recherche_recur(const t_graph *g, t_vertex x, t_vertex y, t_stack *path)
{
    assert(g != NULL);
    assert(path != NULL);
    assert(0 <= x && x < g->size);
    assert(0 <= y && y < g->size);

    int n = taille_graphe(g);
    t_bool *marking = (t_bool*)malloc(n * sizeof(*marking));
    assert(marking != NULL);

    for (int i = 0; i < n; i++) marking[i] = 0;
    *path = NULL;

    t_bool found = Recherche_recur_f(g, x, y, marking, path);

    free(marking);
    return found;
}

// Affichage du chemin stocké dans la pile avec un ordre

static void afficher_chemin(t_stack *path) {
    if (stack_empty(path)) {
        printf("Aucun chemin\n");
        return;
    }
    t_vertex v = pop(path);
    printf("%d", v);
    while (!stack_empty(path)) {
        v = pop(path);
        printf(" -> %d", v);
    }
    printf("\n");
}



